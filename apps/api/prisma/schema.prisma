generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id            String   @id
  name          String
  district      String
  address       String
  cep           String?
  street        String?
  number        String?
  city          String?
  state         String?
  lat           Float?
  lng           Float?
  students      Int
  capacity      Int
  routes        Int
  status        String
  tone          String
  shift         String
  pickupWindow  String
  dropoffWindow String
  manager       String
  phone         String
  notes         String
  routeList     Json
  contacts      Json
  studentList   Student[]
  routesList    Route[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Student {
  id        String   @id
  name      String
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  routeId   String?
  route     Route?   @relation(fields: [routeId], references: [id], onDelete: SetNull)
  routeName String
  shift     String
  status    String
  guardian  String
  phone     String
  address   String
  district  String?
  entryTime String?
  cep       String?
  street    String?
  number    String?
  city      String?
  state     String?
  lat       Float?
  lng       Float?
  notes     String
  stops     RouteStop[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([routeId])
}

model Route {
  id          String    @id
  name        String
  schoolId    String?
  school      School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  shift       String
  status      String
  startTime   String
  endTime     String
  capacity    Int
  vehicleId   String?
  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  students    Student[]
  stops       RouteStop[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([schoolId])
}

model Vehicle {
  id        String   @id
  plate     String
  model     String
  capacity  Int
  status    String
  notes     String
  garageCep    String?
  garageStreet String?
  garageNumber String?
  garageDistrict String?
  garageCity   String?
  garageState  String?
  garageLat    Float?
  garageLng    Float?
  routes    Route[]
  stops     RouteStop[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RouteStop {
  id         String   @id @default(cuid())
  routeId    String
  route      Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  studentId  String?
  student    Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  vehicleId  String?
  vehicle    Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  type       String
  sequence   Int
  arrival    String?
  distanceKm Float?
  durationMin Float?
  createdAt  DateTime @default(now())

  @@index([routeId])
  @@index([studentId])
  @@index([vehicleId])
}
